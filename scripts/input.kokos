

type CString = unmanaged [Int8];

import function puts(str: CString);

struct Person {
    name: CString,
    age: Int
}

export function main() {
    let str = "stijn";

    let i = 10;
    while i > 0 {
        puts(str);
        i = i - 1;
    }

    let person = createPerson("stijn", 10);

    if destroyed(person) {
        puts("person destroyed");
    }

    return str.length;
}

function createPerson(name: CString, age: Int): Person {
    return Person(name: name, age: age);
}