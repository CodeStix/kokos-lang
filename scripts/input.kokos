// i want to change the way arrays work internally. i don't like the double pointer approach and that a array length could change any time. i want to reduce its complexity by:
// including the length of the array in the fat pointer: struct FatArrPtr {i64 gen, i64 len, struct{i64 gen, T[] inlineElements}* ptr}

// please also simplyfy the fixed vs dynamic arrays:
// when instantiating a fixed array, a FatArrPtr is created just like dynamic arrays. i expect the optimizer to optimize out the constant value used when constructing an array with fixed size
// so during codegen, non-value fixed arrays and dynamic arrays have the same internal format.
// value arrays keep their vector conversion

// but i would like to keep the possibility to realloc in the future. in the future i could (don't implement this right now):

// stdlib realloc
import function realloc(arr: unmanaged [Int], newSize: Int): unmanaged [Int];

// This function could either resize the array inplace, or free the previous array and allocate a new one, copying its data
function expandArray(arr: owned [Int], newArrSize: Int): owned [Int] {
    // remaining question: how to invalidate previous generation?
    let newPtr = realloc(arr, newArrSize + sizeof(arr.length))
    arr.length = newArrSize;
    return newPtr;
}







void* block = malloc(200); // allocates at 1000

auto gen_ptr = {block->generation, block};
block->generation += 1; // memory[1000] = 1;
free(block);

// gen_ptr.gen == 0
// block->generation == 1
check(gen_ptr) -> fails: 0 != 1

void largeBlock = malloc(1500); // allocates at 500 (overlaps with previous block that is freed)
memset(largeBlock, 1500, 0); // set the whole block to 0

// gen_ptr.gen == 0
// block->generation == 0
check(gen_ptr) -> OK: 0 == 0 THIS IS FATAL, THE POINTER IS VALID AGAIN BECAUSE OF THE NEWLY ALLOCATED BLOCK OVERWROTE THE GENERATION VALUE OF THE FREED POINTER


